FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir ".[synthid,vault,postgres]"
RUN useradd -r markwright && mkdir -p /data && chown markwright /data
USER markwright
EXPOSE 8000
CMD ["uvicorn", "markwright.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
